; strt1: the Dreamcast start-up's first module (Sega's syStart 1.15, the build for the NAOMI library), in
; place of the arcade's. It is the first input of the link: it names every section, so the linker lays
; them out in this order from DSGLH, and it holds the tables of their starts and ends that strt2 and
; Shinobi read.

          .EXPORT   _START_SYS
          .IMPORT   __INIT

; the program's first bytes (8C010000): the library handles lie between this and DSGLE
          .SECTION  DSGLH,DATA,ALIGN=4
_START_SYS:
          nop
          nop
          nop
          nop
          nop
          nop
          mov.l     ccr_adr,r0          ; the cache control register
          mov.l     @r0,r1
          mov.l     ccr_and,r2
          and       r2,r1
          mov.w     ccr_or,r2
          or        r2,r1
          mov.l     r1,@r0
          mov.l     init_adr,r0
          jmp       @r0                 ; strt2
          nop
ccr_or:   .DATA.W   H'0800
          .ALIGN    4
ccr_adr:  .DATA.L   H'FF00001C
ccr_and:  .DATA.L   H'000089AF
init_adr: .DATA.L   __INIT
          .SDATA    "Lib Handle Start"

          .SECTION  DSGLE,DATA,ALIGN=4
handle_end:
          .DATA.L   0,0,0,0
          .SDATA    "Lib Handle End  "

          .SECTION  P,CODE,ALIGN=4
          .SECTION  P$32,CODE,ALIGN=32

; the program's own sections
          .SECTION  C,DATA,ALIGN=4
          .EXPORT   __D_ROM, __D32_ROM, __D_BGN, __D4_END, __D32_BGN, __D_END
          .EXPORT   __ISTACK_END
          .EXPORT   __B_BGN, __B4_END, __B32_BGN, __B_END
          .EXPORT   __PRESG_BGN, __PRESG_END, __POSTSG_BGN, __POSTSG_END
          .EXPORT   __PRE_BGN, __PRE_END, __POST_BGN, __POST_END
__D_ROM:      .DATA.L   (STARTOF D)
__D32_ROM:    .DATA.L   (STARTOF D32)
__D_BGN:      .DATA.L   (STARTOF R)
__D4_END:     .DATA.L   (STARTOF R)+(SIZEOF R)
__D32_BGN:    .DATA.L   (STARTOF R32)
__D_END:      .DATA.L   (STARTOF R32)+(SIZEOF R32)
__ISTACK_END: .DATA.L   (STARTOF ISTACK)+(SIZEOF ISTACK)
__B_BGN:      .DATA.L   (STARTOF B)
__B4_END:     .DATA.L   (STARTOF B)+(SIZEOF B)
__B32_BGN:    .DATA.L   (STARTOF B32)
__B_END:      .DATA.L   (STARTOF B32)+(SIZEOF B32)
__PRESG_BGN:  .DATA.L   (STARTOF DSG_INIT_)
__PRESG_END:  .DATA.L   (STARTOF DSG_INIT_)+(SIZEOF DSG_INIT_)
__POSTSG_BGN: .DATA.L   (STARTOF DSG_END_)
__POSTSG_END: .DATA.L   (STARTOF DSG_END_)+(SIZEOF DSG_END_)
__PRE_BGN:    .DATA.L   (STARTOF D_INIT_)
__PRE_END:    .DATA.L   (STARTOF D_INIT_)+(SIZEOF D_INIT_)
__POST_BGN:   .DATA.L   (STARTOF D_END_)
__POST_END:   .DATA.L   (STARTOF D_END_)+(SIZEOF D_END_)

          .SECTION  C32,DATA,ALIGN=32
          .SECTION  D,DATA,ALIGN=4
          .SECTION  D32,DATA,ALIGN=32
          .SECTION  DSG_INIT_,DATA,ALIGN=4
          .SECTION  DSG_END_,DATA,ALIGN=4
          .SECTION  CSG_$VTBL,DATA,ALIGN=4
          .SECTION  D_INIT_,DATA,ALIGN=4
          .SECTION  D_END_,DATA,ALIGN=4
          .SECTION  C_$VTBL,DATA,ALIGN=4
          .SECTION  R,DATA,ALIGN=4
          .SECTION  R32,DATA,ALIGN=32
          .SECTION  PSG,CODE,ALIGN=4

; the libraries' sections
          .SECTION  CSG,DATA,ALIGN=4
          .EXPORT   __DSGLH_BGN, __DSGLH_END, __DSGLE_BGN, __DSGLE_END
          .EXPORT   __DSG_ROM, __DSG32_ROM, __DSG_BGN, __DSG4_END, __DSG32_BGN, __DSG_END
          .EXPORT   __BSG_BGN, __BSG4_END, __BSG32_BGN, __BSG_END
          .EXPORT   __G0_BGN
__DSGLH_BGN:  .DATA.L   (STARTOF DSGLH)
__DSGLH_END:  .DATA.L   (STARTOF DSGLH)+(SIZEOF DSGLH)
__DSGLE_BGN:  .DATA.L   (STARTOF DSGLE)
__DSGLE_END:  .DATA.L   (STARTOF DSGLE)+(SIZEOF DSGLE)
__DSG_ROM:    .DATA.L   (STARTOF DSG)
__DSG32_ROM:  .DATA.L   (STARTOF DSG32)
__DSG_BGN:    .DATA.L   (STARTOF RSG)
__DSG4_END:   .DATA.L   (STARTOF RSG)+(SIZEOF RSG)
__DSG32_BGN:  .DATA.L   (STARTOF RSG32)
__DSG_END:    .DATA.L   (STARTOF RSG32)+(SIZEOF RSG32)
__BSG_BGN:    .DATA.L   (STARTOF BSG)
__BSG4_END:   .DATA.L   (STARTOF BSG)+(SIZEOF BSG)
__BSG32_BGN:  .DATA.L   (STARTOF BSG32)
__BSG_END:    .DATA.L   (STARTOF BSG32)+(SIZEOF BSG32)
__G0_BGN:     .DATA.L   (STARTOF $G0)

; the sixteen sections of the movie library: starts, ends and sizes
          .EXPORT   __START_PSGSFD00, __END_PSGSFD00, __SIZE_PSGSFD00
          .EXPORT   __START_PSGSFD01, __END_PSGSFD01, __SIZE_PSGSFD01
          .EXPORT   __START_PSGSFD02, __END_PSGSFD02, __SIZE_PSGSFD02
          .EXPORT   __START_PSGSFD03, __END_PSGSFD03, __SIZE_PSGSFD03
          .EXPORT   __START_PSGSFD04, __END_PSGSFD04, __SIZE_PSGSFD04
          .EXPORT   __START_PSGSFD05, __END_PSGSFD05, __SIZE_PSGSFD05
          .EXPORT   __START_PSGSFD06, __END_PSGSFD06, __SIZE_PSGSFD06
          .EXPORT   __START_PSGSFD07, __END_PSGSFD07, __SIZE_PSGSFD07
          .EXPORT   __START_PSGSFD08, __END_PSGSFD08, __SIZE_PSGSFD08
          .EXPORT   __START_PSGSFD09, __END_PSGSFD09, __SIZE_PSGSFD09
          .EXPORT   __START_PSGSFD10, __END_PSGSFD10, __SIZE_PSGSFD10
          .EXPORT   __START_PSGSFD11, __END_PSGSFD11, __SIZE_PSGSFD11
          .EXPORT   __START_PSGSFD12, __END_PSGSFD12, __SIZE_PSGSFD12
          .EXPORT   __START_PSGSFD13, __END_PSGSFD13, __SIZE_PSGSFD13
          .EXPORT   __START_PSGSFD14, __END_PSGSFD14, __SIZE_PSGSFD14
          .EXPORT   __START_PSGSFD15, __END_PSGSFD15, __SIZE_PSGSFD15
__START_PSGSFD00: .DATA.L (STARTOF PSGSFD00)
__START_PSGSFD01: .DATA.L (STARTOF PSGSFD01)
__START_PSGSFD02: .DATA.L (STARTOF PSGSFD02)
__START_PSGSFD03: .DATA.L (STARTOF PSGSFD03)
__START_PSGSFD04: .DATA.L (STARTOF PSGSFD04)
__START_PSGSFD05: .DATA.L (STARTOF PSGSFD05)
__START_PSGSFD06: .DATA.L (STARTOF PSGSFD06)
__START_PSGSFD07: .DATA.L (STARTOF PSGSFD07)
__START_PSGSFD08: .DATA.L (STARTOF PSGSFD08)
__START_PSGSFD09: .DATA.L (STARTOF PSGSFD09)
__START_PSGSFD10: .DATA.L (STARTOF PSGSFD10)
__START_PSGSFD11: .DATA.L (STARTOF PSGSFD11)
__START_PSGSFD12: .DATA.L (STARTOF PSGSFD12)
__START_PSGSFD13: .DATA.L (STARTOF PSGSFD13)
__START_PSGSFD14: .DATA.L (STARTOF PSGSFD14)
__START_PSGSFD15: .DATA.L (STARTOF PSGSFD15)
__END_PSGSFD00:   .DATA.L (STARTOF PSGSFD00)+(SIZEOF PSGSFD00)
__END_PSGSFD01:   .DATA.L (STARTOF PSGSFD01)+(SIZEOF PSGSFD01)
__END_PSGSFD02:   .DATA.L (STARTOF PSGSFD02)+(SIZEOF PSGSFD02)
__END_PSGSFD03:   .DATA.L (STARTOF PSGSFD03)+(SIZEOF PSGSFD03)
__END_PSGSFD04:   .DATA.L (STARTOF PSGSFD04)+(SIZEOF PSGSFD04)
__END_PSGSFD05:   .DATA.L (STARTOF PSGSFD05)+(SIZEOF PSGSFD05)
__END_PSGSFD06:   .DATA.L (STARTOF PSGSFD06)+(SIZEOF PSGSFD06)
__END_PSGSFD07:   .DATA.L (STARTOF PSGSFD07)+(SIZEOF PSGSFD07)
__END_PSGSFD08:   .DATA.L (STARTOF PSGSFD08)+(SIZEOF PSGSFD08)
__END_PSGSFD09:   .DATA.L (STARTOF PSGSFD09)+(SIZEOF PSGSFD09)
__END_PSGSFD10:   .DATA.L (STARTOF PSGSFD10)+(SIZEOF PSGSFD10)
__END_PSGSFD11:   .DATA.L (STARTOF PSGSFD11)+(SIZEOF PSGSFD11)
__END_PSGSFD12:   .DATA.L (STARTOF PSGSFD12)+(SIZEOF PSGSFD12)
__END_PSGSFD13:   .DATA.L (STARTOF PSGSFD13)+(SIZEOF PSGSFD13)
__END_PSGSFD14:   .DATA.L (STARTOF PSGSFD14)+(SIZEOF PSGSFD14)
__END_PSGSFD15:   .DATA.L (STARTOF PSGSFD15)+(SIZEOF PSGSFD15)
__SIZE_PSGSFD00:  .DATA.L (SIZEOF PSGSFD00)
__SIZE_PSGSFD01:  .DATA.L (SIZEOF PSGSFD01)
__SIZE_PSGSFD02:  .DATA.L (SIZEOF PSGSFD02)
__SIZE_PSGSFD03:  .DATA.L (SIZEOF PSGSFD03)
__SIZE_PSGSFD04:  .DATA.L (SIZEOF PSGSFD04)
__SIZE_PSGSFD05:  .DATA.L (SIZEOF PSGSFD05)
__SIZE_PSGSFD06:  .DATA.L (SIZEOF PSGSFD06)
__SIZE_PSGSFD07:  .DATA.L (SIZEOF PSGSFD07)
__SIZE_PSGSFD08:  .DATA.L (SIZEOF PSGSFD08)
__SIZE_PSGSFD09:  .DATA.L (SIZEOF PSGSFD09)
__SIZE_PSGSFD10:  .DATA.L (SIZEOF PSGSFD10)
__SIZE_PSGSFD11:  .DATA.L (SIZEOF PSGSFD11)
__SIZE_PSGSFD12:  .DATA.L (SIZEOF PSGSFD12)
__SIZE_PSGSFD13:  .DATA.L (SIZEOF PSGSFD13)
__SIZE_PSGSFD14:  .DATA.L (SIZEOF PSGSFD14)
__SIZE_PSGSFD15:  .DATA.L (SIZEOF PSGSFD15)

          .SECTION  CSG32,DATA,ALIGN=32
          .SECTION  DSG,DATA,ALIGN=4
          .SECTION  DSG32,DATA,ALIGN=32
          .SECTION  RSG,DATA,ALIGN=4
          .SECTION  RSG32,DATA,ALIGN=32

