; _mvsto2b: the compiler's run-time routine that stores a 16-bit value as two bytes, the high byte
; first. r4 is the destination, r5 points at the halfword. The section is padded to 36 bytes with 0xFF.

          .SECTION  P,CODE,ALIGN=4
          .EXPORT   __mvsto2b

__mvsto2b:
          mov       r4,r0
          add       #2,r0
          mov       #8,r7
          mov       r4,r6
loop:
          mov.w     @r5,r3
          neg       r7,r2
          extu.w    r3,r3
          shld      r2,r3
          mov.b     r3,@r6
          add       #1,r6
          cmp/hs    r0,r6
          bf/s      loop
          add       #-8,r7
          rts
          nop
          .DATA.W   H'FFFF,H'FFFF,H'FFFF

          .END
