; nlSystemWork: the library's work, which GBR holds while it runs (the palette's mode and flag are
; its first bytes), 0x64 bytes, in Sega's section for work aligned to a cache line.

          .SECTION  B$32,DATA,ALIGN=32
          .EXPORT   _NLSystemWork_
          .EXPORT   _nl_scale_factor

_NLSystemWork_:
          .RES.B    40
_nl_scale_factor:
          .RES.B    60

          .END
