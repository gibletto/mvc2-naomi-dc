          add       #1,r9
          bt        tri_nc_end
          bra       _nl_objputmv_triangle_nc
          fschg
tri_nc_skip2:
          bsr       _nl_objput_mv_get_and_calc
          add       #1,r9
          bt        tri_nc_skip2_end
          fschg
          tst       r3,r3
          add       #1,r9
          bt        tri_nc_end
          bra       _nl_objputmv_triangle_nc
          fschg
tri_nc_skip2_end:
          bsr       _nl_objput_mv_calc_p0p2_C
          fschg
          bsr       _nl_objput_mv_calc_p0p1_A
          fmov      fr5,fr13
          flds      fr14,fpul
          sts       fpul,r8
          flds      fr13,fpul
          mov       #1,r0
          sts       fpul,r2
          lds       r0,fpul
          bsr       _nl_objput_mv_send_p0
          add       #32,r6
          tst       r3,r3
          add       #1,r9
          bt        tri_nc_end
          bra       _nl_objputmv_triangle_nc
          fschg
tri_nc_end:
          mov.l     @r4,r0
          cmp/pl    r0
          bt        tri_nc_next_hdr
          bra       list_end
tri_nc_next_hdr:
          tst       #128,r0
          add       #4,r4
          bt/s      tri_nc_hdr_kind
          mov.l     @r4+,r3
          bra       tri_nc_start
          fschg
tri_nc_hdr_kind:
          tst       #16,r0
          fschg
          bf        tri_nc_hdr_strip
          bra       tri_nc_start
tri_nc_hdr_strip:
          nop
          bra       _nl_objputmv_strip_nc
          nop
          .ALIGN    32

; takes the next vertex as p2 (fr12..fr15, 1/w in fr15); T is set when it is in front of the near plane
_nl_objput_mv_get_and_calc:
          fmov      @r14+,fr12
          dt        r3
          fmov      @r14+,fr14
          float     fpul,fr15
          mov       r4,r14
          bt/s      get_calc_fetched
          ftrv      xmtrx,fv12
          mov.l     @r4,r0
          add       #32,r4
          tst       #1,r0
          bf        get_calc_fetched
          mov.l     @(4,r14),r14
          add       #-24,r4
          add       r4,r14
get_calc_fetched:
          pref      @r14
          fcmp/gt   fr15,fr1
          flds      fr15,fpul
          mov       #1,r0
          fldi1     fr15
          fdiv      fr12,fr15
          fsts      fpul,fr12
          rts
          lds       r0,fpul
          .ALIGN    16

; the point where edge p0-p1 meets the near plane, into the slot picked by r9's parity
_nl_objput_mv_calc_p0p1_A:
          fmov      fr4,fr12
          fsub      fr8,fr12
          fmov      fr1,fr0
          fsub      fr8,fr0
          fmov      fr6,fr3
          fsub      fr10,fr3
          fmov      fr5,fr2
          fsub      fr9,fr2
          fmov      fr10,fr14
          fdiv      fr12,fr0
          fmov      fr9,fr13
          lds       r7,fpul
          fsts      fpul,fr15
          mov       #1,r0
          lds       r0,fpul
          mov       r9,r0
          tst       #1,r0
          mov       #12,r0
          bt        calc_p0p1_slot
          mov       #36,r0
calc_p0p1_slot:
          fmac      fr0,fr3,fr14
          fmac      fr0,fr2,fr13
          fmul      fr15,fr14
          fmul      fr15,fr13
          fmov      fr15,@(r0,r6)
          add       #-4,r0
          fmov      fr14,@(r0,r6)
          add       #-4,r0
          rts
          fmov      fr13,@(r0,r6)

; sends p2 (it becomes the new p0) and moves the queue on
_nl_objput_mv_send_p2:
          pref      @r6
          mov       r6,r0
          fmov      fr14,fr6
          fmul      fr15,fr14
          fmov      fr12,fr4
          fmul      fr15,fr13
          add       #-4,r0
          fschg
          fmov      fr15,@-r0
          add       #32,r6
          fmov      fr14,@-r0
          add       #64,r5
          fmov      fr13,@-r0
          rts
          pref      @r0
          .ALIGN    4

; copies p2 into the other slot to go on with the strip
_nl_objput_mv_cont_strip_C:
          tst       #1,r0
          mov       #36,r0
          bt        cont_strip_slot
          mov       #12,r0
cont_strip_slot:
          fmov      fr15,@(r0,r6)
          add       #-4,r0
          fmov      fr14,@(r0,r6)
          add       #-4,r0
          rts
          fmov      fr13,@(r0,r6)

; swaps p0 and p1
_nl_objput_mv_xchg_p0p1:
          fmov      fr4,fr12
          fmov      fr6,fr14
          fmov      fr8,fr4
          fmov      fr10,fr6
          rts
          fmov      fr12,fr8

; the point where edge p0-p2 meets the near plane, sent
_nl_objput_mv_calcsend_p0p2:
          add       #32,r6
          pref      @r6
          fsub      fr12,fr4
          fmov      fr1,fr0
          fsub      fr12,fr0
          fmov      fr6,fr3
          fsub      fr14,fr3
          fmov      fr5,fr2
          fsub      fr13,fr2
          fdiv      fr4,fr0
          fmov      fr15,fr7
          fmov      fr14,fr6
          fmov      fr13,fr5
          fmov      fr12,fr4
          lds       r7,fpul
          fsts      fpul,fr15
          mov       #1,r0
          lds       r0,fpul
          fmac      fr0,fr3,fr14
          fmac      fr0,fr2,fr13
          mov       r6,r0
          fmul      fr15,fr14
          add       #-4,r0
          fmul      fr15,fr13
          fmov      fr15,@-r0
          add       #32,r6
          fmov      fr14,@-r0
          add       #64,r5
          fmov      fr13,@-r0
          rts
          pref      @r0
          .ALIGN    4

; the point where edge p0-p1 meets the near plane, sent
_nl_objput_mv_calcsend_p0p1:
          pref      @r6
          fmov      fr4,fr12
          fsub      fr8,fr12
          fmov      fr1,fr0
          fsub      fr8,fr0
          fmov      fr6,fr3
          fsub      fr10,fr3
          fmov      fr5,fr2
          fsub      fr9,fr2
          fmov      fr10,fr14
          fdiv      fr12,fr0
          fmov      fr9,fr13
          lds       r7,fpul
          fsts      fpul,fr15
          mov       #1,r0
          lds       r0,fpul
          fmac      fr0,fr3,fr14
          fmac      fr0,fr2,fr13
          mov       r6,r0
          fmul      fr15,fr14
          add       #-4,r0
          fmul      fr15,fr13
          fmov      fr15,@-r0
          add       #32,r6
          fmov      fr14,@-r0
          add       #64,r5
          fmov      fr13,@-r0
          rts
          pref      @r0
          .ALIGN    8

; sends the cut vertex words kept in r7, r8 and r2 into the slot picked by r0's parity
_nl_objput_mv_send_edge_A:
          tst       #1,r0
          mov       #16,r0
          bt        send_edge_slot
          mov       #40,r0
send_edge_slot:
          add       r6,r0
          mov.l     r7,@-r0
          add       #32,r6
          mov.l     r8,@-r0
          add       #64,r5
          pref      @r6
          add       #32,r6
          mov.l     r2,@-r0
          rts
          pref      @r0

; puts p1 back into the slot
_nl_objput_mv_restore_p1_A:
          tst       #1,r0
          mov       #16,r0
          bt        restore_p1_slot
          mov       #40,r0
restore_p1_slot:
          fmov      fr11,fr15
          add       r6,r0
          fmov      fr10,fr14
          fmul      fr15,fr14
          fmov      fr9,fr13
          fmul      fr15,fr13
          fmov      fr15,@-r0
          fmov      fr14,@-r0
          rts
          fmov      fr13,@-r0

; sends p0
_nl_objput_mv_send_p0:
          pref      @r6
          mov       r6,r0
          fmov      fr7,fr15
          add       #-4,r0
          fmov      fr6,fr14
          fmul      fr15,fr14
          fmov      fr5,fr13
          fmul      fr15,fr13
          fmov      fr15,@-r0
          add       #32,r6
          fmov      fr14,@-r0
          add       #64,r5
          fmov      fr13,@-r0
          rts
          pref      @r0
          .ALIGN    32

; puts p0 back into the slot
_nl_objput_mv_restore_p0_C:
          tst       #1,r0
          mov       #40,r0
          bt        restore_p0_slot
          mov       #16,r0
restore_p0_slot:
          fmov      fr7,fr15
          add       r6,r0
          fmov      fr6,fr14
          fmul      fr15,fr14
          fmov      fr5,fr13
          fmul      fr15,fr13
          fmov      fr15,@-r0
          fmov      fr14,@-r0
          rts
          fmov      fr13,@-r0

; the point where edge p0-p2 meets the near plane, into the slot picked by r9's parity
_nl_objput_mv_calc_p0p2_C:
          fsub      fr12,fr4
          fmov      fr1,fr0
          fsub      fr12,fr0
          fmov      fr6,fr3
          fsub      fr14,fr3
          fmov      fr5,fr2
          fsub      fr13,fr2
          fdiv      fr4,fr0
          fmov      fr15,fr7
          fmov      fr14,fr6
          fmov      fr13,fr5
          fmov      fr12,fr4
          lds       r7,fpul
          fsts      fpul,fr15
          mov       #1,r0
          lds       r0,fpul
          mov       r9,r0
          tst       #1,r0
          mov       #40,r0
          bt        calc_p0p2_slot
          mov       #16,r0
calc_p0p2_slot:
          fmac      fr0,fr3,fr14
          fmac      fr0,fr2,fr13
          fmul      fr15,fr14
          add       r6,r0
          fmul      fr15,fr13
          fmov      fr15,@-r0
          fmov      fr14,@-r0
          rts
          fmov      fr13,@-r0

; sends the cut vertex words kept in r7, r8 and r2
_nl_objput_mv_send_edge_B:
          pref      @r6
          mov       r6,r0
          add       #-4,r0
          mov.l     r7,@-r0
          add       #32,r6
          mov.l     r8,@-r0
          add       #64,r5
          mov.l     r2,@-r0
          rts
          pref      @r0

          .END
