          fldi0     fr2
          fadd      fr7,fr2
          fldi1     fr7
          add       #64,r6
          fldi0     fr3
          add       #32,r5
          fmov      @r14+,fr0
          ftrv      xmtrx,fv4
          fldi0     fr11
          dt        r3
