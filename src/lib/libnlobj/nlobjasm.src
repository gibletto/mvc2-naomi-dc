          add       #-8,r4
          fmov      fr4,@-r6
          mov.l     r2,@r6
          fschg
          pref      @r6
          rts
          add       #32,r6

; specular triangle
ttx_spec:
          mov       #127,r2
          mov       #3,r3
          mov.l     @r4+,r9
