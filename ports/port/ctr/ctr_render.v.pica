; ctr_render.v.pica  The vertex shader: screen-space vertices with 1/w, multiplied by w for perspective
; texturing; the fixed normal and view let lighting read a texel as a palette index

.fvec projection[4]

.constf consts(1.0, 0.0, 0.00392156863, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outquat normalquat
.out outview view

.alias inpos v0             ; x, y in pixels, the depth (0 to 1), w
.alias intc v1              ; u, v
.alias inclr v2             ; the colour's bytes: B, G, R, A

.proc main
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.x
    dp4 r1.x, projection[0], r0
    dp4 r1.y, projection[1], r0
    dp4 r1.z, projection[2], r0
    dp4 r1.w, projection[3], r0
    mul outpos, r1, inpos.wwww
    mov outtc0, intc
    mul outclr, consts.zzzz, inclr.zyxw
    mov outquat, consts.yyyx
    mov outview, consts.yyxy
    end
.end