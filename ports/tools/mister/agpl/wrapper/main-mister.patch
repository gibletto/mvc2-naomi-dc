 {
 	int start, end;
 	int size = user_io_status_bits(opt, &start, &end, ex);
 	if (!size) return;
 
+	// Capture trigger pulses (single-bit set to 1) as sticky flags
+	if (value == 1 && size == 1)
+		g_status_trigger_flags |= (1u << start);
+
 	int s = start / 8;
 	int e = end / 8;
 
